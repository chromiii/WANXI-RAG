# Copy this file to .env for local development.
# Never commit a populated .env.

# Optional private runtime directory.
# Leave empty to use <repo>/data/private.
WANXI_DATA_DIR=

# LLM configuration.
# DEEPSEEK_API_KEY is required only for live mode.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=5000

# Local Elasticsearch.
# docker-compose.yml binds Elasticsearch to localhost only.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=wanxi-rag-evidence-v1
